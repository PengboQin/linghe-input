void cloudLearningTests(){
 auto taobaoCount=[](const Json&entry,const std::string&producer){for(const auto&r:entry.at("accepted").items)if(r.at("text").str()=="淘宝")return r.at("counts").at(producer).num();throw std::runtime_error("expected synthetic Taobao row");};
 auto p=fixtureRoot/"cloud-owner";GroupClient owner(p);std::cerr<<"cloud stage initial\n";check(!owner.cloudLearningStatus().at("enabled").boolean());owner.recordContent("tao bao","淘宝");owner.importLegacyLearning("好\thao \t7\n臺灣\ttai wan \t2\n",owner.personalEpoch());std::cerr<<"cloud stage create\n";owner.create("https://relay.example.invalid");owner.consentContent(true,true);std::cerr<<"cloud stage optin\n";owner.consentCloudLearning(true,true);check(owner.cloudLearningStatus().at("enabled").boolean());
 std::cerr<<"cloud stage sync\n";tick+=600001;owner.syncContent();auto state=loadPrivate(p/"cloud-learning-shadow-v1.dpapi");check(state.at("producers").fields.size()==2);check(!state.at("shadowReady").boolean());for(const auto&e:state.at("producers").fields){check(e.second.at("receipt").kind==Json::Kind::object);for(const auto&row:e.second.at("accepted").items){check(row.at("counts").fields.size()==1);check(row.at("counts").has(e.first));check(row.at("text").str()!="臺灣");}}
 // The real aggregator ACK, not the op6 upload receipt, enables shadow parity.
 (void)post("https://relay.example.invalid","/_fixture/cloud-aggregate",Json::object({{"group",uuidText(owner.group())}}));std::cerr<<"cloud stage sync\n";tick+=600001;owner.syncContent();state=loadPrivate(p/"cloud-learning-shadow-v1.dpapi");check(state.at("shadowReady").boolean());check(owner.contentSnapshot().at("learningEnabled").boolean());
 // Explicit handover requires the exact model/producer ACK, replaces ranks,
 // and retires old full recency publication to an independent daily repair.
 check(!owner.contentSnapshot().at("cloudRankActive").boolean());owner.authorizeCloudRanking(true);check(owner.contentSnapshot().at("cloudRankActive").boolean());tick+=600001;owner.syncContent();auto compatibility=loadPrivate(p/"recent-v2.dpapi").at("cloudCompatibility");auto beforeRecent=recentRequests;owner.recordContent("hao","好");tick+=600001;owner.syncContent();check(recentRequests==beforeRecent);check(loadPrivate(p/"recent-v2.dpapi").at("cloudCompatibility").at("lastSuccess").num()==compatibility.at("lastSuccess").num());
 auto syntheticRecent=loadPrivate(p/"recent-v2.dpapi");syntheticRecent["cloudCompatibility"]["lastSuccess"]=unixTime()-86401;savePrivate(p/"recent-v2.dpapi",syntheticRecent);GroupClient daily(p);check(daily.contentSnapshot().at("cloudRankActive").boolean());tick+=600001;daily.syncContent();check(recentRequests>beforeRecent);check(loadPrivate(p/"recent-v2.dpapi").at("cloudCompatibility").at("lastSuccess").num()>syntheticRecent.at("cloudCompatibility").at("lastSuccess").num());auto dailyCount=recentRequests;daily.authorizeCloudRanking(false);check(!daily.contentSnapshot().at("cloudRankActive").boolean());tick+=600001;daily.syncContent();check(recentRequests>dailyCount);owner.refreshCloudRanking();
 // Losing only the migration checkpoint recovers FULL existing producer baselines
 // from real op7, then publishes the new own MAX difference without double-count.
 const auto before=owner.contentSnapshot().at("archive");check(fs::remove(p/"cloud-learning-shadow-v1.dpapi"));owner.recordContent("tao bao","淘宝");std::cerr<<"cloud stage sync\n";tick+=600001;owner.syncContent();state=loadPrivate(p/"cloud-learning-shadow-v1.dpapi");check(state.at("producers").fields.size()==2);auto own=state.at("producers").at(uuidText(owner.keys().device));check(taobaoCount(own,uuidText(owner.keys().device))==2);check(!state.at("shadowReady").boolean());
 // Local authorization switches off durably despite an unavailable server;
 // background revocation retries later and does not stop old learning/clipboard.
 std::cerr<<"cloud stage revoke\n";offline=true;owner.consentCloudLearning(false);auto permission=loadPrivate(p/"cloud-learning-permission-v1.dpapi");check(!permission.at("enabled").boolean()&&permission.at("pendingRevoke").boolean());check(owner.contentSnapshot().at("learningEnabled").boolean());offline=false;tick+=600001;owner.syncCloudShadow();permission=loadPrivate(p/"cloud-learning-permission-v1.dpapi");check(!permission.at("enabled").boolean()&&!permission.at("pendingRevoke").boolean());
 // Re-consent restores server baselines and an empty historical publication
 // refreshes binding; previous counters remain MAX, not a new dated selection.
 owner.consentCloudLearning(true);std::cerr<<"cloud stage sync\n";tick+=600001;owner.syncContent();check(owner.cloudLearningStatus().at("enabled").boolean());state=loadPrivate(p/"cloud-learning-shadow-v1.dpapi");own=state.at("producers").at(uuidText(owner.keys().device));check(taobaoCount(own,uuidText(owner.keys().device))==2);
 // A later local disable wins over an in-flight enable response.
 owner.consentCloudLearning(false);afterCloudOperation=3;afterCloudResponse=[&]{GroupClient concurrent(p);offline=true;concurrent.consentCloudLearning(false);offline=false;};bool superseded=false;try{owner.consentCloudLearning(true);}catch(const JsonError&e){superseded=std::string(e.what())=="cloud opt-in superseded";}check(superseded);permission=loadPrivate(p/"cloud-learning-permission-v1.dpapi");check(!permission.at("enabled").boolean()&&permission.at("pendingRevoke").boolean());tick+=600001;owner.syncCloudShadow();check(!loadPrivate(p/"cloud-learning-permission-v1.dpapi").at("pendingRevoke").boolean());
 // Upload acceptance racing local revocation cannot advance the local baseline,
 // pull a model, or resume ranking. Re-opt-in later recovers it through op7.
 owner.consentCloudLearning(true);tick+=600001;owner.syncContent();owner.recordContent("tao bao","淘宝");afterCloudOperation=6;afterCloudResponse=[&]{auto local=loadPrivate(p/"cloud-learning-permission-v1.dpapi");local["enabled"]=false;local["pendingRevoke"]=true;savePrivate(p/"cloud-learning-permission-v1.dpapi",local);};tick+=600001;owner.syncContent();check(!afterCloudResponse);permission=loadPrivate(p/"cloud-learning-permission-v1.dpapi");check(!permission.at("enabled").boolean());state=loadPrivate(p/"cloud-learning-shadow-v1.dpapi");check(state.at("producers").at(uuidText(owner.keys().device)).at("pending").kind==Json::Kind::object);tick+=600001;owner.syncCloudShadow();
 const auto group=owner.group();owner.leave();check(!fs::exists(p/"cloud-learning-permission-v1.dpapi")&&!fs::exists(p/"cloud-learning-shadow-v1.dpapi"));check(!owner.connected());
 std::cout<<"PASS actual GroupClient/cloud server signature, opt-in, op7 MAX recovery, op6 own+legacy isolation, worker ACK, offline durable revoke, reconsent, departure cleanup; shadow only; no network/socket/device\n";
